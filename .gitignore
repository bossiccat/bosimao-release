# 永久忽略，杜绝误提交进入 jax-voice-api 候选包。见 .github/workflows/release-governance.yml
# 的 "Verify CloudRun canonical source is tracked" 步骤。
/deploy/backend/

# ===== 2026-09-14 发布门禁：清空 DIRTY_WORKTREE（策略决定，非临时绕过）=====
# 背景：verify_claims 要求 `git status --porcelain` 输出为空。以下都是**构建产物、
# 回滚备份、恢复材料或一次性探针输出**，按惯例不该出现在 git 状态里；其中多项
# （packaged sidecar 运行时、生产回滚 exe、git 恢复材料）**不能删**，只能忽略。
# 注意：这不是为了"让门禁变绿"而掩盖问题 —— 判据是"这些东西本来就不该入库"。

# git 事故恢复材料（已移出仓库到 ../_jax-git-recovery-*，此处兜底防回归）
/.git.backup*
/.git.disaster*

# 生产回滚备份与 APK 签名产物
/jax-backend.exe.bak-pre-swap-*
*.apk.idsig

