# ===== 环境变量模板（复制为 .env 并填写） =====

# 模型服务（llama.cpp-omni）
MODEL_SERVER_HOST=127.0.0.1
MODEL_SERVER_PORT=19080
MODEL_DIR=D:\models\MiniCPM-o-4_5-gguf
MODEL_FILE=MiniCPM-o-4_5-Q4_K_M.gguf
MODEL_CTX_SIZE=8192
MODEL_NGL=99

# 后端
BACKEND_PORT=8000

# 推送：企业微信机器人 webhook（群机器人添加后获取）
WECOM_WEBHOOK_URL=

# 推送：ntfy（默认官方服务器，也可自建）
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# 日志级别
LOG_LEVEL=INFO
