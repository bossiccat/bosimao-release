# ===== 环境变量模板（复制为 .env 并填写） =====

# 模型服务（llama.cpp-omni）
MODEL_SERVER_HOST=127.0.0.1
MODEL_SERVER_PORT=19080
MODEL_DIR=D:\models\MiniCPM-o-4_5-gguf
MODEL_FILE=MiniCPM-o-4_5-Q4_K_M.gguf
MODEL_CTX_SIZE=8192
MODEL_NGL=99

# 后端
BACKEND_PORT=8000

# TLS 商业级安全底座（相对 PROJECT_ROOT 的证书路径；留空=明文，仅限本地开发）
# 生产（VOICE_PRODUCTION=true）必须配置 cert/key 并启用 HTTPS/WSS
TLS_CERTFILE=certs/server.crt
TLS_KEYFILE=certs/server.key
TLS_CA_CERTFILE=certs/ca.crt

# 推送：企业微信机器人 webhook（群机器人添加后获取）
WECOM_WEBHOOK_URL=

# 推送：ntfy（默认官方服务器，也可自建）
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# 日志级别
LOG_LEVEL=INFO

# voice 网关鉴权（mobile-voice-spec §7/§8，V1.5 M1）：手机 WS 连接 token；留空=开发态放行
VOICE_TOKEN=

# ===== 中继（backend/relay/，V1.5 M2，部署目标=CloudBase CloudRun） =====
# RELAY_TOKEN：中继 WS 鉴权；留空=开发态放行（生产必须配置，部署前用 openssl rand -base64 32 生成）
RELAY_TOKEN=
# RELAY_E2EE_KEY：AES-256-GCM 预共享密钥（32 字节 base64）；留空=启动时生成开发密钥并告警
#   生成：python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
#   手机/PC 两端必须使用同一密钥（仅本地联调可留空）
RELAY_E2EE_KEY=

# ===== TRTC 实时音视频（ADR-012 / PC-INTEGRATION §2.3，RTC 会话签发） =====
# 从腾讯云 TRTC 控制台获取（应用管理→应用信息→SDK 密钥）；SecretKey 仅存 .env，禁止进代码/文档/git
TRTC_SDKAPPID=0
TRTC_SECRETKEY=
# Node/Electron sidecar 独立控制面 Bearer；由宿主进程环境注入，禁止写入本文件或日志
# VOICE_SIDECAR_CREDENTIAL=<runtime-only>
# 房间号前缀：手机端房间 = <前缀><device_id>（同 device 幂等复用）
TRTC_ROOM_PREFIX=jax-

# ===== owner credential（ADR-022 D4，桌宠 → 后端的 owner 身份） =====
# 首启由 provision_owner_credential 自生成（CSPRNG 32B→hex）写入 CM + 本文件，
# 禁止手工填固定值（否则所有装机共享同一 admin bearer，属致命失败模式）。
VOICE_OWNER_CREDENTIAL=

