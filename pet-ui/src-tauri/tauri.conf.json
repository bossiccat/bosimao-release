{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "贾克斯·星核",
  "version": "1.0.0",
  "identifier": "com.jax.pet",
  "mainBinaryName": "jax-pet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:bundle",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "贾克斯 · 星核",
        "width": 200,
        "height": 200,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focusable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "externalBin": [
      "binaries/jax-rtc-sidecar",
      "binaries/provision_sidecar_credential",
      "binaries/provision_sidecar_credential_launcher"
    ],
    "resources": {
      "binaries/jax-rtc-sidecar-runtime/": "jax-rtc-sidecar-runtime/"
    }
  }
}
