<?xml version="1.0" encoding="utf-8"?>
<!--
  设计 Token — 商业化浅色主题（白底 + 绿色品牌色）
  品牌绿 #16A34A / 浅绿底 #DCFCE7 / 深字 #052E16 / 错误红 #DC2626 / 背景白 #FFFFFF。
  业务布局与 Drawable 只能引用资源名，禁止写颜色字面量。
  jax_color_* 为语义名；jax_*/state_*/conn_* 为存量兼容别名（指向同一 token 值，
  资源名保持不变，MainActivity / WaveformView / FloatingOverlay 等引用零改动）。
-->
<resources>
    <!-- 语义名：白底 + 绿色品牌 -->
    <color name="jax_color_bg">#FFFFFF</color>               <!-- 背景 -->
    <color name="jax_color_surface">#FFFFFF</color>          <!-- 卡片面 -->
    <color name="jax_color_surface_raised">#F0FDF4</color>   <!-- 卡内浮起面（浅绿） -->
    <color name="jax_color_surface_subtle">#F8FAFC</color>   <!-- 细微底 -->
    <color name="jax_color_on_surface">#052E16</color>       <!-- 深字 -->
    <color name="jax_color_on_surface_muted">#64748B</color> <!-- 弱化字 -->
    <color name="jax_color_on_accent">#FFFFFF</color>        <!-- 绿底上的白字 -->
    <color name="jax_color_accent">#16A34A</color>           <!-- 品牌绿 -->
    <color name="jax_color_accent_hover">#15803D</color>
    <color name="jax_color_accent_active">#166534</color>
    <color name="jax_color_accent_soft">#DCFCE7</color>      <!-- 浅绿底（徽章/波形底） -->
    <color name="jax_color_border">#E2E8F0</color>           <!-- 卡片描边 -->
    <color name="jax_color_border_soft">#EEF2F6</color>
    <color name="jax_color_border_strong">#CBD5E1</color>
    <color name="jax_color_success">#16A34A</color>
    <color name="jax_color_warning">#94A3B8</color>          <!-- 中间态一律灰 -->
    <color name="jax_color_error">#DC2626</color>            <!-- 错误红 -->
    <color name="jax_color_info">#94A3B8</color>
    <color name="jax_color_focus">#16A34A</color>
    <color name="jax_color_disabled_bg">#F1F5F9</color>
    <color name="jax_color_disabled_fg">#94A3B8</color>
    <color name="jax_color_overlay_stroke">#33000000</color>  <!-- overlay ball outline token -->

    <!-- 语音体验状态色（绿=正常、灰=空闲/中间态、红=错误） -->
    <color name="jax_color_voice_idle">#94A3B8</color>
    <color name="jax_color_voice_connecting">#94A3B8</color>
    <color name="jax_color_voice_listening">#16A34A</color>
    <color name="jax_color_voice_endpointing">#16A34A</color>
    <color name="jax_color_voice_thinking">#16A34A</color>
    <color name="jax_color_voice_speaking">#16A34A</color>
    <color name="jax_color_voice_interrupted">#94A3B8</color>
    <color name="jax_color_voice_recovering">#94A3B8</color>
    <color name="jax_color_voice_error">#DC2626</color>

    <!-- 存量兼容别名（Java/布局现有引用；值 = 上方对应 token） -->
    <color name="jax_accent">#16A34A</color>
    <color name="jax_muted">#64748B</color>
    <color name="jax_bg">#FFFFFF</color>
    <color name="jax_surface">#FFFFFF</color>
    <color name="jax_surface2">#F0FDF4</color>
    <color name="jax_fg">#052E16</color>
    <color name="jax_fg2">#334155</color>
    <color name="jax_border">#E2E8F0</color>

    <!-- 语音状态色（MainActivity 六态显示） -->
    <color name="state_idle">#94A3B8</color>
    <color name="state_monitoring">#16A34A</color>
    <color name="state_listening">#16A34A</color>
    <color name="state_thinking">#16A34A</color>
    <color name="state_speaking">#16A34A</color>
    <color name="state_alerting">#DC2626</color>

    <!-- 连接状态 -->
    <color name="conn_connected">#16A34A</color>
    <color name="conn_connecting">#94A3B8</color>
    <color name="conn_disconnected">#94A3B8</color>
</resources>
