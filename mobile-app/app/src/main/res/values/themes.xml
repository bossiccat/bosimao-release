<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 波斯猫 v0.4：浅色主题（白底深字）。windowLightStatusBar 让状态栏图标深色（API 23+）；forceDarkAllowed 关闭系统强制深色 -->
    <style name="Theme.JaxVoice" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/jax_accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">@color/jax_bg</item>
        <item name="colorOnSurface">@color/jax_fg</item>
        <item name="colorSurfaceVariant">@color/jax_surface2</item>
        <item name="colorOnSurfaceVariant">@color/jax_fg2</item>
        <item name="android:colorBackground">@color/jax_bg</item>
        <item name="android:statusBarColor">@color/jax_bg</item>
        <item name="android:navigationBarColor">@color/jax_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
