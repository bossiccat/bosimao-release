<?xml version="1.0" encoding="utf-8"?>
<!--
  商业化主界面（白底+绿）：品牌 + 状态徽章 → 波形卡 → 动作区 → 设置入口。
  开发/运维字段（PC 网关 / 唤醒次数 / 会话服务器 / 悬浮窗 / 电池白名单）已移出可视区：
  视图保留 visibility="gone"（ID 不变），MainActivity 状态绑定零改动，后续进「高级/诊断」页。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jax_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部：品牌 + 状态徽章（色点 + 文字） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/jax_fg"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <View
                    android:id="@+id/dotPhase"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_overlay_ball" />

                <TextView
                    android:id="@+id/tvPhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/phase_idle"
                    android:textColor="@color/jax_fg"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvServiceState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/service_stopped"
            android:textColor="@color/jax_muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 诊断卡：开发/运维字段移出可视区（gone，ID 与绑定保留）+ 出错红字提示 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_connection"
                    android:textColor="@color/jax_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/conn_disconnected"
                    android:textColor="@color/jax_fg2"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_wake_count"
                    android:textColor="@color/jax_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvWakeCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/jax_fg2"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_server"
                    android:textColor="@color/jax_muted"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvServer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textColor="@color/jax_fg2"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 诊断：连接/配对失败原因（红色小字，出错时显示） -->
            <TextView
                android:id="@+id/tvLastError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:textColor="@color/jax_color_error"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 波形卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/waveform_hint"
                android:textColor="@color/jax_fg2"
                android:textSize="14sp" />

            <com.jax.voice.ui.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_waveform" />
        </LinearLayout>

        <!-- 动作区：立即对话（主）→ 启动/停止监听（次）→ 设置 -->
        <Button
            android:id="@+id/btnTalk"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/btn_talk"
            android:textColor="@color/jax_color_on_accent"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/jax_color_accent"
            app:cornerRadius="@dimen/jax_radius_xl" />

        <Button
            android:id="@+id/btnToggleListen"
            android:layout_width="match_parent"
            android:layout_height="@dimen/jax_touch_target_min"
            android:layout_marginTop="12dp"
            android:text="@string/btn_start_listen"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/jax_touch_target_min"
            android:layout_marginTop="4dp"
            android:text="@string/btn_settings"
            android:textColor="@color/jax_fg2"
            style="@style/Widget.Material3.Button.TextButton" />

        <!-- 悬浮窗/电池白名单引导：移至设置页，主界面隐藏（ID 保留防绑定断裂） -->
        <Button
            android:id="@+id/btnOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_overlay_guide"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_battery_guide"
            android:visibility="gone"
            style="@style/Widget.Material3.Button.OutlinedButton" />
    </LinearLayout>
</ScrollView>
